{
  "name": "tree-sql-indexer",
  "dataSourceName": "tree-sql-datasource",
  "targetIndexName": "<search-index-name>",
  "fieldMappings": [
    { "sourceFieldName": "id", "targetFieldName": "id" },
    { "sourceFieldName": "sourceType", "targetFieldName": "sourceType" },
    { "sourceFieldName": "appIdentifier", "targetFieldName": "appIdentifier" },
    { "sourceFieldName": "appDisplayName", "targetFieldName": "appDisplayName" },
    { "sourceFieldName": "treeId", "targetFieldName": "treeId" },
    { "sourceFieldName": "treeKey", "targetFieldName": "treeKey" },
    { "sourceFieldName": "treeDisplayName", "targetFieldName": "treeDisplayName" },
    { "sourceFieldName": "nodeId", "targetFieldName": "nodeId" },
    { "sourceFieldName": "parentNodeId", "targetFieldName": "parentNodeId" },
    { "sourceFieldName": "title", "targetFieldName": "title" },
    { "sourceFieldName": "nodeText", "targetFieldName": "nodeText" },
    { "sourceFieldName": "notes", "targetFieldName": "notes" },
    { "sourceFieldName": "breadcrumb", "targetFieldName": "breadcrumb" },
    { "sourceFieldName": "content", "targetFieldName": "content" },
    { "sourceFieldName": "isLeafNode", "targetFieldName": "isLeafNode" },
    { "sourceFieldName": "depth", "targetFieldName": "depth" },
    { "sourceFieldName": "sortPath", "targetFieldName": "sortPath" },
    { "sourceFieldName": "attachmentCount", "targetFieldName": "attachmentCount" },
    { "sourceFieldName": "hasAttachments", "targetFieldName": "hasAttachments" },
    { "sourceFieldName": "attachmentMetadataJson", "targetFieldName": "attachmentMetadataJson" },
    { "sourceFieldName": "updatedAt", "targetFieldName": "updatedAt" },
    { "sourceFieldName": "createdAt", "targetFieldName": "createdAt" }
  ],
  "parameters": {
    "maxFailedItems": 10,
    "maxFailedItemsPerBatch": 5
  }
}