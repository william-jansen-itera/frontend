{
  "name": "tree-blob-indexer",
  "schedule": {
    "interval": "P1D"
  },
  "dataSourceName": "tree-blob-datasource",
  "targetIndexName": "tree-content-index",
  "skillsetName": "tree-image-enrichment-skillset",
  "fieldMappings": [
    {
      "sourceFieldName": "metadata_storage_path",
      "targetFieldName": "id",
      "mappingFunction": {
        "name": "base64Encode"
      }
    },
    {
      "sourceFieldName": "sourcetype",
      "targetFieldName": "sourceType"
    },
    {
      "sourceFieldName": "treeid",
      "targetFieldName": "treeId"
    },
    {
      "sourceFieldName": "nodeid",
      "targetFieldName": "nodeId"
    },
    {
      "sourceFieldName": "applicationidentifier",
      "targetFieldName": "appIdentifier"
    },
    {
      "sourceFieldName": "blobname",
      "targetFieldName": "blobName"
    },
    {
      "sourceFieldName": "originalfilename",
      "targetFieldName": "attachmentFileName"
    },
    {
      "sourceFieldName": "metadata_storage_path",
      "targetFieldName": "blobUrl"
    },
    {
      "sourceFieldName": "updatedbyobjectid",
      "targetFieldName": "updatedByObjectId"
    },
    {
      "sourceFieldName": "updatedbyuserdetails",
      "targetFieldName": "updatedByUserDetails"
    },
    {
      "sourceFieldName": "content",
      "targetFieldName": "content"
    }
  ],
  "outputFieldMappings": [
    {
      "sourceFieldName": "/document/normalized_images/*/ocrText",
      "targetFieldName": "ocrText"
    },
    {
      "sourceFieldName": "/document/normalized_images/*/imageDescription/captions/*/text",
      "targetFieldName": "imageDescription"
    },
    {
      "sourceFieldName": "/document/normalized_images/*/imageDescription/captions/*/confidence",
      "targetFieldName": "imageDescriptionConfidence"
    },
    {
      "sourceFieldName": "/document/normalized_images/*/filteredDescriptions/*",
      "targetFieldName": "imageDescriptionFiltered"
    }
  ],
  "parameters": {
    "maxFailedItems": 10,
    "maxFailedItemsPerBatch": 5,
    "configuration": {
      "dataToExtract": "contentAndMetadata",
      "imageAction": "generateNormalizedImages",
      "indexedFileNameExtensions": ".csv,.doc,.docx,.gif,.html,.jpeg,.jpg,.json,.md,.pdf,.png,.ppt,.pptx,.txt,.webp,.xls,.xlsx"
    }
  }
}